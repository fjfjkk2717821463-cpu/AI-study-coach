#!/bin/sh
#
# 提交前密钥扫描：只检查本次暂存的内容，发现高危项就阻止提交。
# 启用方式（每个克隆只需执行一次）：
#     git config core.hooksPath .githooks
# 临时跳过（确认是误报时）：
#     git commit --no-verify

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

if [ ! -f tools/secret_scan.py ]; then
  echo "提示：未找到 tools/secret_scan.py，跳过密钥扫描。"
  exit 0
fi

for PY in python3 .venv/bin/python /usr/bin/python3 python; do
  if command -v "$PY" >/dev/null 2>&1 || [ -x "$PY" ]; then
    if "$PY" tools/secret_scan.py --staged --quiet; then
      exit 0
    fi
    echo ""
    echo "✖ 提交被拦截：暂存内容里检测到疑似密钥或敏感信息。"
    echo "  请处理后再提交；确认为误报可执行：git commit --no-verify"
    exit 1
  fi
done

echo "提示：未找到可用的 Python 解释器，跳过密钥扫描。"
exit 0
